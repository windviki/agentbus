{
  "description": "AgentBus lifecycle delivery plus an active-turn async watcher. Review and trust these entries with /hooks.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "agentbus hook --async-watch", "timeout": 600, "async": true }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 5 }] }
    ],
    "Interrupt": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 3 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "agentbus hook", "timeout": 3 }] }
    ]
  }
}
